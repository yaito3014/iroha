# Rendered by setup.sh to live/mediamtx.yml — edit the .tmpl, not the output.

logLevel: info

api: yes
apiAddress: :9997
metrics: no
pprof: no
playback: no

rtsp: yes
rtspAddress: :8554
rtspTransports: [tcp]
rtspEncryption: "no"
rtmp: yes
# RTMPS on :1936 with Caddy's certificate for {{LIVE_HOST}} (mounted from
# caddy-data; MediaMTX reloads it when Caddy renews it). Plain RTMP on :1935
# stays open until every streamer has switched OBS over.
rtmpEncryption: "optional"
rtmpAddress: :1935
rtmpsAddress: :1936
rtmpServerCert: /certs/{{LIVE_HOST}}.crt
rtmpServerKey: /certs/{{LIVE_HOST}}.key
hls: no
srt: no
moq: no

webrtc: yes
webrtcAddress: :8889
webrtcEncryption: no            # TLS is terminated by Caddy
webrtcAllowOrigins: ['*']
webrtcTrustedProxies: ['172.16.0.0/12']
webrtcLocalUDPAddress: :8189
webrtcLocalTCPAddress: :8189
webrtcIPsFromInterfaces: no
# Inside Docker MediaMTX only sees its container IP, so advertise the public
# host instead; MediaMTX resolves it for each new WebRTC session.
webrtcAdditionalHosts: ['{{LIVE_HOST}}']
webrtcICEServers2: []
webrtcHandshakeTimeout: 10s
webrtcTrackGatherTimeout: 2s
webrtcSTUNGatherTimeout: 5s

# The keys service (keys/keys.py) decides: publishing needs a streamer's own
# key (?pass=<key>), and the API is allowed from the host / docker network only.
# Watching is excluded from the hook, so anyone may watch.
authMethod: http
authHTTPAddress: http://keys:8000/auth
authHTTPExclude:
  - action: read

paths:
  # Accept any path name; the OBS stream key chooses it (e.g. rtspt://{{LIVE_HOST}}/<name>).
  all_others:
    # Names are free for every streamer, so do not let a second publisher
    # disconnect the one already live on a name.
    overridePublisher: false
