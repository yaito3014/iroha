# Rendered by setup.sh to caddy/sites/live.caddy (when the live profile is on),
# which the main Caddyfile imports — edit the .tmpl, not the output.
{{LIVE_HOST}} {
    # Let's Encrypt only (no ZeroSSL fallback): MediaMTX reads this site's
    # certificate for RTMPS from the issuer's directory in caddy-data.
    tls {
        issuer acme
    }
    # Control panel + MediaMTX API: login via Authentik ({{ID_HOST}}) using
    # forward auth against its embedded outpost.
    handle /outpost.goauthentik.io/* {
        reverse_proxy https://{{ID_HOST}} {
            header_up Host {upstream_hostport}
        }
    }
    # The panel's data, both from the keys service: the caller's own stream key
    # (/keys/*) and a filtered view of MediaMTX's API (/api/*), which never
    # shows anyone's key. forward_auth replaces any client-sent
    # X-Authentik-Username with Authentik's, which the keys service trusts.
    @panel_data path /api/* /keys/*
    handle @panel_data {
        forward_auth https://{{ID_HOST}} {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-Authentik-Username
            trusted_proxies private_ranges
            header_up Host {upstream_hostport}
        }
        reverse_proxy keys:8001
    }
    handle / {
        forward_auth https://{{ID_HOST}} {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-Authentik-Username X-Authentik-Email
            trusted_proxies private_ranges
            header_up Host {upstream_hostport}
        }
        reverse_proxy panel:80
    }
    # Everything else (viewer pages, WHIP/WHEP) goes to MediaMTX, unauthenticated:
    # MediaMTX asks the keys service who may publish; anyone may read.
    handle {
        reverse_proxy mediamtx:8889
    }
}
