# Copy to .env and edit. `./setup.sh` renders the *.tmpl configs from these.

# Public hostnames (A records -> this VPS, DNS-only / grey cloud)
HEADSCALE_HOST=headscale.example.com
DEX_HOST=dex.example.com
# Lore server. Doubles as the Dex client_id and the JWT audience (host =
# client_id = aud), and is the QUIC endpoint clients dial. Shares this VPS.
LORE_HOST=lore.example.com
# Lore web frontend (kaguya-web, on the Lore VPS). Doubles as its Dex client_id;
# Dex registers it as a public auth-code + PKCE client with a redirect URI.
LORE_WEB_HOST=app.lore.example.com

# MagicDNS base domain — must NOT be a domain the hosts above live under directly
TAILNET_BASE_DOMAIN=tailnet.example.com

# Identity allowed to join the tailnet (and to sign in to Dex's demo user DB)
ADMIN_EMAIL=admin@example.com

# bcrypt hash of the demo admin password. Generate with:
#   docker run --rm httpd:2.4 htpasswd -bnBC 10 "" 'yourpassword' | tr -d ':\n'
# Keep the value single-quoted: the hash contains `$`, and the quotes stop
# docker compose from interpolating it (setup.sh strips the quotes).
ADMIN_PASSWORD_HASH=''

# Filled automatically by setup.sh on first run — leave empty
HEADSCALE_OIDC_SECRET=
