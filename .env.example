# Copy to .env and edit. `./setup.sh` renders the *.tmpl configs from these.

# Public hostname of this stack (A record -> this VPS, DNS-only / grey cloud)
HEADSCALE_HOST=headscale.example.com

# Authentik OIDC issuer host (a separate VPS, not this one). Headscale logs in
# against this provider's per-application issuer, https://<ID_HOST>/application/o/headscale/.
ID_HOST=id.example.com

# MagicDNS base domain — must NOT be the service hostname above
TAILNET_BASE_DOMAIN=tailnet.example.com

# Identity allowed to join the tailnet (matched against the verified email
# Authentik releases; see oidc.allowed_users in headscale/config.yaml.tmpl)
ADMIN_EMAIL=admin@example.com

# Client secret of the Authentik "headscale" OAuth2 provider (confidential
# client). Copy it from Authentik (Applications -> Providers -> Headscale) and
# paste it here.
HEADSCALE_OIDC_SECRET=

# --- live/ (optional MediaMTX streaming; see README) — leave LIVE_HOST empty to disable ---
# Enables the live services. Combine with other profiles comma-separated.
COMPOSE_PROFILES=
# Public hostname of the stream site (A record -> this VPS, DNS-only), e.g. live.example.com
LIVE_HOST=
# This VPS's public IP, advertised to WebRTC clients as an ICE candidate
LIVE_PUBLIC_IP=
# Password OBS uses to publish (stream key: <name>?user=publisher&pass=<this>)
LIVE_PUBLISH_PASS=

# --- Automated updates (ops/update.sh; see README) — all optional ---
# URL to POST deploy/failure notices to, e.g. an ntfy.sh topic. Empty = journal only.
UPDATE_NOTIFY_URL=
# UPDATE_BRANCH=main
# UPDATE_BACKUP_DIR=/var/backups/<stack>
# UPDATE_BACKUP_KEEP=5
