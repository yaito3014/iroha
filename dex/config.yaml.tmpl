# Rendered by setup.sh — edit the .tmpl, not the output.
issuer: https://{{DEX_HOST}}/dex

storage:
  type: sqlite3
  config:
    file: /var/dex/dex.db

web:
  http: 0.0.0.0:5556   # TLS terminated by Caddy

oauth2:
  skipApprovalScreen: true

expiry:
  idTokens: 24h

staticClients:
  # Headscale web login — confidential client, code flow + PKCE.
  - id: headscale
    name: Headscale
    secret: "{{HEADSCALE_OIDC_SECRET}}"
    redirectURIs:
      - https://{{HEADSCALE_HOST}}/oidc/callback
  # Lore application client. Public (no secret) so the OAuth 2.0 device flow
  # works from the CLI. The id doubles as the hostname and the token audience.
  - id: {{LORE_HOST}}
    name: {{LORE_HOST}}
    public: true
  # Lore web frontend (kaguya-web). Public client using the auth-code flow with
  # PKCE (no secret to sync across hosts); unlike the device-flow client it has a
  # redirect URI. The id is the frontend hostname and the token audience.
  - id: {{LORE_WEB_HOST}}
    name: {{LORE_WEB_HOST}}
    public: true
    redirectURIs:
      - https://{{LORE_WEB_HOST}}/auth/callback
# Demo user store. Replace with a real connector (GitHub, LDAP, SAML, ...)
# for actual use; connectors also unlock the `groups` claim.
enablePasswordDB: true
staticPasswords:
  - email: {{ADMIN_EMAIL}}
    hash: "{{ADMIN_PASSWORD_HASH}}"
    username: admin
    userID: 08a8684b-db88-4b73-90a9-3cd1661f5466
